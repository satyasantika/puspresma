# Produksi — salin ke .env di server (chmod 600). JANGAN commit .env. Tidak ada rahasia di berkas contoh ini.
APP_VERSION=1.0.0
# true hanya saat rilis yang membutuhkan migrasi (container app menjalankan migrate --force)
RUN_MIGRATIONS=false
APP_NAME="Puspresma FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=puspresma
APP_ENV=production
APP_DEBUG=false
# Buat sekali: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show   (SIMPAN salinan aman: kunci
# ini mengenkripsi data sensitif dan rahasia MFA; kehilangannya membuat data tak terbaca).
APP_KEY=

# Subpath produksi: ganti "puspresma" dengan nama aplikasi. APP_URL = ASSET_URL; aset dibangun dengan ASSET_URL yang sama.
APP_URL=https://supportfkip.unsil.ac.id/puspresma
ASSET_URL=https://supportfkip.unsil.ac.id/puspresma
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB native di host (dijangkau container lewat host.docker.internal). Buat DB dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_puspresma
DB_USERNAME=app
DB_PASSWORD=

# Cookie sesi ber-path /puspresma dan hanya HTTPS. TRUSTED_PROXIES = IP reverse proxy fakultas (bukan *).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Kosong = mengikuti path APP_URL (mis. /puspresma).
SESSION_PATH=
SESSION_COOKIE=puspresma_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=puspresma_cache_

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.
# dicabut bersama Horizon
HORIZON_EMAILS=

# Surel keluar lewat SMTP fakultas
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="puspresma@unsil.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PUSPRESMA_DOMAIN_MAHASISWA=student.unsil.ac.id
PUSPRESMA_DOMAIN_PEGAWAI=unsil.ac.id
GOOGLE_LOGIN_ENABLED=false

# Docker (opsional)
PUSPRESMA_VERSI=0.1.0
HTTP_PORT=8032
BACKUP_DIR=./backups
BACKUP_RETENSI_HARI=30
# spatie/laravel-backup (arsip DB terenkripsi): isi password kuat dan SIMPAN terpisah dari server
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=backup
# BACKUP_PATH=/backups   # volume terpisah; untuk S3/MinIO set BACKUP_DISK=s3 dan AWS_*

# Akun super-admin awal (php artisan db:seed --force); kata sandi acak dicetak sekali ke konsol
SEED_SUPERADMIN_EMAIL=fkip@unsil.ac.id
SEED_SUPERADMIN_NAME="Super Admin"
# Sandi awal akun baru (kosong = acak). Wajib diganti setelah masuk pertama.
SEED_SUPERADMIN_PASSWORD=
# MFA authenticator: false = dimatikan sementara; true = wajib bagi super-admin dan admin-fakultas.
MFA_AKTIF=false
