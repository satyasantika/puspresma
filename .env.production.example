# Produksi — salin ke .env di server (chmod 600). JANGAN commit .env. Tidak ada rahasia di berkas contoh ini.
APP_VERSION=0.1.0
APP_NAME="Puspresma FKIP Unsil"
APP_ENV=production
APP_DEBUG=false
# Buat sekali: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show   (SIMPAN salinan aman: kunci
# ini mengenkripsi data sensitif dan rahasia MFA; kehilangannya membuat data tak terbaca).
APP_KEY=

# Subpath produksi (STANDAR-TEKNIS §2.4): APP_URL = ASSET_URL; aset dibangun dengan ASSET_URL yang sama.
APP_URL=https://supportfkip.unsil.ac.id/puspresma
ASSET_URL=https://supportfkip.unsil.ac.id/puspresma
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB native di host (dijangkau container lewat host.docker.internal). Buat DB dan pengguna khusus aplikasi.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_puspresma
DB_USERNAME=app
DB_PASSWORD=

# Cookie sesi ber-path /puspresma dan hanya HTTPS. TRUSTED_PROXIES = IP reverse proxy fakultas (bukan *).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/puspresma
SESSION_COOKIE=puspresma_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=puspresma_cache_

# Redis internal compose (tanpa port ke host). REDIS_PASSWORD wajib (dipakai compose untuk --requirepass).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=puspresma_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
HORIZON_PREFIX=puspresma_horizon:
HORIZON_EMAILS=

# Surel keluar lewat SMTP fakultas
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="puspresma@unsil.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PUSPRESMA_DOMAIN_MAHASISWA=student.unsil.ac.id
PUSPRESMA_DOMAIN_PEGAWAI=unsil.ac.id
GOOGLE_LOGIN_ENABLED=false

# Docker (opsional)
PUSPRESMA_VERSI=0.1.0
HTTP_PORT=8032
BACKUP_DIR=./backups
BACKUP_RETENSI_HARI=30

# Akun super-admin awal (php artisan db:seed --force); kata sandi acak dicetak sekali ke konsol
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_NAME="Super Admin"
