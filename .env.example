APP_NAME="Puspresma FKIP Unsil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal lewat compose pusat: http://localhost:8032 (tanpa subpath) | produksi: https://supportfkip.unsil.ac.id/puspresma
# Produksi: APP_ENV=production, APP_DEBUG=false, ASSET_URL sama dengan APP_URL, SESSION_PATH=/puspresma, SESSION_SECURE_COOKIE=true, TRUSTED_PROXIES=<ip reverse proxy>
APP_URL=http://localhost:8032
ASSET_URL=http://localhost:8032

APP_VERSION=0.2.0
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (dijangkau container lewat host.docker.internal)
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_puspresma
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=puspresma_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=*
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=puspresma_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=puspresma_
REDIS_DB=40
REDIS_CACHE_DB=41
REDIS_QUEUE_DB=42
HORIZON_PREFIX=puspresma_horizon:
HORIZON_EMAILS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="puspresma@unsil.ac.id"
MAIL_FROM_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"

# Puspresma
PUSPRESMA_DOMAIN_MAHASISWA=student.unsil.ac.id
PUSPRESMA_DOMAIN_PEGAWAI=unsil.ac.id
FONNTE_URL=https://api.fonnte.com/send
FONNTE_TOKEN=

BERKAS_MODE=tautan

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Akun super-admin awal (php artisan db:seed); kata sandi acak dicetak sekali ke konsol
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_NAME="Super Admin"
